# Copy to .env.homelab locally (deploy script syncs it as remote .env).
# On the N4020, the live file is /mnt/data/compose/gogirlabs/.env (mode 600).
# Never commit real secrets.

# Database (Compose service names; not exposed on the host)
DB_NAME=gogirlabs
DB_USER=gogirlabs
DB_PASSWORD=change-me-strong-db-password

# Django
SECRET_KEY=change-me-to-a-random-string-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=api.gogirlabs.uk
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://www.gogirlabs.uk,https://gogirlabs.uk
CSRF_TRUSTED_ORIGINS=https://www.gogirlabs.uk,https://gogirlabs.uk
FRONTEND_URL=https://www.gogirlabs.uk
# TLS terminates on ikon; leave False for local healthchecks on :8001
SECURE_SSL_REDIRECT=False

# Optional: override LAN bind IP if gogir-server is not .21
# HOMELAB_BIND_IP=192.168.0.21

# Optional: use a pre-built image instead of building on the host
# BACKEND_IMAGE=youruser/gogir-labs-backend:latest

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gogirlabs.uk
