# Copy to .env.homelab locally (deploy script syncs it as remote .env).
# On the N4020, the live file is /mnt/data/compose/gogirlabs/.env (mode 600).
# Never commit real secrets.

# Database (Compose service names; not exposed on the host)
DB_NAME=gogirlabs
DB_USER=gogirlabs
DB_PASSWORD=change-me-strong-db-password

# Django
SECRET_KEY=change-me-to-a-random-string-at-least-50-characters-long
DEBUG=False
# Hostname only (no ports). localhost is required for the compose healthcheck.
# Also include HOMELAB_BIND_IP so LAN curls (http://<bind>:8001/...) pass Host checks.
ALLOWED_HOSTS=api.gogirlabs.uk,localhost,127.0.0.1,192.0.2.10
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://www.gogirlabs.uk,https://gogirlabs.uk
CSRF_TRUSTED_ORIGINS=https://www.gogirlabs.uk,https://gogirlabs.uk
FRONTEND_URL=https://www.gogirlabs.uk
# Absolute origin for /media/ links inside seeded blog HTML (essay images).
PUBLIC_API_ORIGIN=https://api.gogirlabs.uk
# Serve /media/ through Django (homelab has no separate media nginx).
SERVE_MEDIA=True
# TLS terminates on ikon; leave False for local healthchecks on :8001
SECURE_SSL_REDIRECT=False

# Required. LAN address of this API host. Do not publish Postgres or Redis.
# Keep this value listed in ALLOWED_HOSTS above.
HOMELAB_BIND_IP=192.0.2.10

# Optional: use a pre-built image instead of building on the host
# BACKEND_IMAGE=youruser/gogir-labs-backend:latest

# Email — Cloudflare Email Sending (transactional SMTP, implicit TLS).
# Token needs the Email Sending: Edit permission. Username is the literal api_token.
# Onboard gogirlabs.uk for Email Routing too, and forward hi@, newsletter@, and dev@
# to a verified personal inbox. Campaign fan-out stays off (transactional only).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mx.cloudflare.net
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=api_token
EMAIL_HOST_PASSWORD=your-cloudflare-email-sending-token
DEFAULT_FROM_NAME=Gogir Labs
DEFAULT_FROM_EMAIL=hi@gogirlabs.uk
NEWSLETTER_FROM_EMAIL=newsletter@gogirlabs.uk
EMAIL_REPLY_TO=hi@gogirlabs.uk
NEWSLETTER_BROADCASTS_ENABLED=False
